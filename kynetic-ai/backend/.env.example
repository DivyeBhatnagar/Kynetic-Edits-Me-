# ── Kynetic AI — Environment Variable Reference ──────────────────────────────
# Copy this file to .env and fill in the values for local development.
# NEVER commit .env to source control.
#
# In production, these are injected via Kubernetes Secrets or a secrets manager.
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kynetic:kynetic@localhost:5432/kynetic

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a strong secret in production:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# ── OTP ───────────────────────────────────────────────────────────────────────
PHONE_OTP_TTL_SECONDS=600
PHONE_OTP_MAX_ATTEMPTS=3

# ── Internal Service URLs (used by API Gateway) ───────────────────────────────
AUTH_SERVICE_URL=http://auth_service:8001
MARKETPLACE_SERVICE_URL=http://marketplace_service:8002
WALLET_BILLING_SERVICE_URL=http://wallet_billing_service:8003
PROVISIONING_SERVICE_URL=http://provisioning_service:8004
AI_ROUTER_COPILOT_SERVICE_URL=http://ai_router_copilot_service:8005
REPUTATION_PRICING_SERVICE_URL=http://reputation_pricing_service:8006
HYBRID_BROKER_SERVICE_URL=http://hybrid_broker_service:8007
MONITORING_SERVICE_URL=http://monitoring_service:8008

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# CORS_ORIGINS=["http://localhost:3000","https://app.kynetic.ai"]
