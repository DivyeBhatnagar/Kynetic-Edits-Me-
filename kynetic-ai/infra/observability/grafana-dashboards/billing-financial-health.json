  "panels": [
    {
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "Wallet Top-up Volume (Last 1h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(kynetic_wallet_topups_total[1h]))",
          "legendFormat": "Top-ups Count",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Payment Provider Breakdown (Razorpay vs Stripe)",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(kynetic_wallet_topups_total[1h])) by (provider)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Webhook Processing Failures",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(kynetic_payment_webhook_failures_total[1h]))",
          "legendFormat": "Webhook Failures",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1.0 }
            ]
          }
        }
      }
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "title": "Wallet Debit Velocity & Hourly Spend Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kynetic_wallet_debits_amount_total[5m]))",
          "legendFormat": "Debit Amount Rate/sec",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 5,
      "title": "GST Invoice Generation Rate (INR Invoices)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
